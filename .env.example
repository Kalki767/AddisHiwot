# Local development settings. `make up` copies this file to .env the first time;
# edit .env (never committed), not this file. All values here are fake.

# Address the containers' ports are published on. 127.0.0.1 keeps them on this
# machine only; use 0.0.0.0 to reach them from a phone on the same Wi-Fi.
BIND_ADDRESS=127.0.0.1

# API (backend/). The API builds DATABASE_URL from the POSTGRES_* values below.
APP_ENV=development
API_PORT=8080
LOG_LEVEL=info
# Signs access tokens. At least 32 bytes; make a real one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Keys the HMAC of email codes. At least 32 bytes; make a real one with: openssl rand -base64 48
AUTH_CODE_SECRET=dev-only-code-secret-change-me-0123456789
# Sender of the app's emails (they land in Mailpit in development). Keep the quotes: make loads this file with the shell.
MAIL_FROM="Addis Hiwot <no-reply@addishiwot.test>"
# Google sign-in: the app's OAuth client IDs (Android, iOS, web), comma-separated.
# Empty turns Google sign-in off (the endpoint answers 503).
GOOGLE_CLIENT_IDS=

# PostgreSQL + pgvector
POSTGRES_USER=addishiwot
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=addishiwot
POSTGRES_PORT=5433

# Mailpit: catches every email sent in development (web inbox on MAILPIT_UI_PORT)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# MinIO (S3-compatible file storage). The password needs at least 8 characters.
MINIO_ROOT_USER=addishiwot
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
